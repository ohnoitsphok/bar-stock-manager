# Set default behavior to automatically detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure web assets and scripts use LF line endings
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
